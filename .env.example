XAI_API_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
TWILIO_AUTH_TOKEN=
# Set to `true` in production when the webhook is exposed to Twilio.
# Leave empty (=false) for local testing without real Twilio credentials.
VERIFY_TWILIO_SIGNATURE=
# CORS allowlist for the browser. Comma-separated for multiple origins
# (e.g. "https://kavach.vercel.app,https://kavach-staging.vercel.app").
# Defaults to http://localhost:5173 for local dev.
FRONTEND_ORIGIN=

# Rate limit for /analyze and /webhook (per client IP, per minute).
# Defaults to 30. Set KAVACH_RATE_LIMIT_ENABLED=false to disable entirely.
KAVACH_RATE_LIMIT_PER_MIN=
KAVACH_RATE_LIMIT_ENABLED=
